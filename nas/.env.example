# Copy to .env, replace all CHANGE_ME values. Do not commit .env.
NAS_BIND_IP=127.0.0.1
NAS_PUBLIC_HOST=CHANGE_ME_NAS_IP
TZ=Asia/Seoul
PUID=1000
PGID=1000

# --- portal ---------------------------------------------------------------
# Members sign up with this code. Change it if it leaks; existing accounts stay.
PORTAL_SIGNUP_CODE=CHANGE_ME_LAB_CODE
# Set to 1 when the portal is served over HTTPS (reverse proxy, tunnel, public domain).
PORTAL_SECURE_COOKIES=0

# --- 외부 접속 (선택) -------------------------------------------------------
# Cloudflare Zero Trust에서 만든 터널 토큰. 있으면 docker compose --profile tunnel up -d
# 터널을 쓰면 PORTAL_SECURE_COOKIES=1로 바꾸세요.
TUNNEL_TOKEN=
CLOUDFLARED_TAG=2025.8.1

# --- images ---------------------------------------------------------------
PROMETHEUS_TAG=v3.5.0
GRAFANA_TAG=12.1.1
HOMEPAGE_TAG=v1.4.6
GRAFANA_ADMIN_USER=labadmin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# Include each hostname:port that students actually use, comma separated.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# --- optional: LibreBooking (docker compose --profile librebooking up -d) ---
# Only needed when PORTAL_MODE=live, i.e. LibreBooking owns reservations instead of the portal.
LIBREBOOKING_TAG=develop
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
LB_INSTALL_PASSWORD=CHANGE_ME_INSTALL_PASSWORD
LIBREBOOKING_USERNAME=CHANGE_ME_PORTAL_READER
LIBREBOOKING_PASSWORD=CHANGE_ME_PORTAL_READER_PASSWORD
