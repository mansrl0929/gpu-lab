[Unit]
Description=Read-only data disk usage per user for node_exporter
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/gpu-lab/storage_collector.py
User=root
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/prometheus/node-exporter
PrivateTmp=true
TimeoutStartSec=1800
